{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Astro docs": {
      "type": "remote",
      "url": "https://mcp.docs.astro.build/mcp",
      "enabled": true
    },
    "devenv": {
      "type": "local",
      "command": ["devenv", "mcp"],
      "enabled": true
    },
    "mcp-nixos": {
      "type": "local",
      "command": ["uvx", "mcp-nixos"],
      "enabled": true
    },
    "open-design": {
      "type": "local",
      "command": ["/Users/sylvester/.nix-profile/bin/od", "mcp", "--daemon-url", "http://localhost:7457"],
      "environment": {
        "OD_DATA_DIR": "/Users/sylvester/.od"
      },
      "enabled": true
    }
  }
}
