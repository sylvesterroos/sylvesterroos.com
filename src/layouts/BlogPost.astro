---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Heading = { depth: number; slug: string; text: string };

type Props = CollectionEntry<"blog">["data"] & {
  headings?: Heading[];
  prev?: { id: string; data: CollectionEntry<"blog">["data"] };
  next?: { id: string; data: CollectionEntry<"blog">["data"] };
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroCaption,
  tags,
  headings,
  prev,
  next,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <div class="section article-header">
      <div class="container">
        {
          tags && tags.length > 0 && (
            <div class="meta-row" style="margin-bottom: var(--gap-md);">
              <span class="pill pill-accent">{tags[0]}</span>
              {tags.slice(1).map((tag) => (
                <span class="pill pill-accent">{tag}</span>
              ))}
              <span class="sep">·</span>
              <span class="meta-date">
                <FormattedDate date={pubDate} />
              </span>
            </div>
          )
        }
        {
          (!tags || tags.length === 0) && (
            <div class="meta-row" style="margin-bottom: var(--gap-md);">
              <span class="meta-date">
                <FormattedDate date={pubDate} />
              </span>
            </div>
          )
        }
        {
          updatedDate && (
            <div class="meta-row" style="margin-bottom: var(--gap-md);">
              <span class="meta-date">
                Updated <FormattedDate date={updatedDate} />
              </span>
            </div>
          )
        }
        <h1>
          <span class="accent">/</span>
          {title}
        </h1>
        {description && <p class="lead">{description}</p>}
      </div>
    </div>

    <div class="section">
      <div class="container">
        {
          heroImage && (
            <div class="article-hero">
              <img src={heroImage.src} alt="" />
              {heroCaption && <div class="caption">{heroCaption}</div>}
            </div>
          )
        }

        <div class="article-layout">
          <div class="prose">
            <slot />
          </div>
          {
            headings && headings.length > 0 && (
              <nav class="toc" aria-label="Table of contents">
                <div class="toc-label">Contents</div>
                <ol>
                  {headings
                    .filter((h) => h.depth <= 3)
                    .map((h) => (
                      <li style={`padding-left: ${(h.depth - 1) * 12}px;`}>
                        <a href={`#${h.slug}`}>{h.text}</a>
                      </li>
                    ))}
                </ol>
              </nav>
            )
          }
        </div>
      </div>
    </div>
  </article>

  {
    (prev || next) && (
      <div class="section">
        <div class="container">
          <nav class="post-nav">
            {prev ? (
              <a href={`/blog/${prev.id}/`}>
                <span class="nav-label">Previous</span>
                <span class="nav-title">{prev.data.title}</span>
              </a>
            ) : (
              <div />
            )}
            {next ? (
              <a href={`/blog/${next.id}/`} class="next">
                <span class="nav-label">Next</span>
                <span class="nav-title">{next.data.title}</span>
              </a>
            ) : (
              <div />
            )}
          </nav>
        </div>
      </div>
    )
  }

  <script>
    (function () {
      const headings = document.querySelectorAll(".prose [id]");
      const links = document.querySelectorAll(".toc a");
      if (!headings.length || !links.length) return;

      function setActive(id) {
        links.forEach(function (l) {
          l.classList.toggle("active", l.getAttribute("href") === "#" + id);
        });
      }

      function onScroll() {
        let current = headings[0].id;
        const offset = 100;
        for (let i = 0; i < headings.length; i++) {
          const rect = headings[i].getBoundingClientRect();
          if (rect.top <= offset) current = headings[i].id;
        }
        setActive(current);
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    })();
  </script>
</BaseLayout>
