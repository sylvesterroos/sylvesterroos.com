---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <h1 class="text-6xl font-bold mb-8">Sylvester Roos</h1>
  <p class="mb-8 text-lg">
    I'm a software developer interested in building large scale distributed systems on the BEAM.
  </p>
  <p class="mb-8">
    My stuff is scattered around
    <a
      class="link link-primary"
      href="https://github.com/sylvesterroos"
      target="_blank"
      rel="noopener noreferrer">GitHub</a
    >
    and
    <a
      class="link link-primary"
      href="https://gitlab.com/sylvesterroos/"
      target="_blank"
      rel="noopener noreferrer">GitLab</a
    >.
  </p>
  <p class="mb-8">
    If you want to chat, you can send an email to <i>hello at sylvesterroos dot com</i> or <a
      class="link link-primary"
      href="https://x.com/sylvesterroos"
      target="_blank"
      rel="noopener noreferrer">message me on x.com</a
    >.
  </p>
  <div
    class="mt-8"
    style="padding-top: calc(60% + 10vh); position: relative; margin-left: -5vw; margin-right: -5vw; width: calc(100% + 10vw);"
  >
    <iframe
      src="https://configure.zsa.io/embed/voyager/layouts/Aq0LZ/latest/0"
      style="border: 0; height: 100%; left: 0; position: absolute; top: 0; width: 100%"></iframe>
  </div>
</BaseLayout>
