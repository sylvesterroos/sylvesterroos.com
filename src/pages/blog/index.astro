---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getPublishedBlogPosts } from "../../utils/collections.ts";

const posts = (await getPublishedBlogPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postsByYear: Record<number, typeof posts> = {};
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!postsByYear[year]) postsByYear[year] = [];
  postsByYear[year].push(post);
}
const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout>
  <section class="section">
    <div class="container">
      <p class="seed-line">all posts</p>
      <h1><span class="accent">/</span> blog</h1>
      <p class="lead" style="margin-top: var(--gap-md);">
        Long-form writing on machine learning, systems design, and the shape of tools that think.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="lead" style="text-align: center;">
            No posts yet. Check back soon.
          </p>
        ) : (
          <div class="blog-list">
            {years.map((year) => (
              <>
                <p class="year-header">{year}</p>
                {postsByYear[year].map((post) => (
                  <article class={`blog-item${!post.data.heroImage ? " no-thumb" : ""}`}>
                    {post.data.heroImage && (
                      <div class="thumb">
                        <img src={post.data.heroImage.src} alt="" />
                      </div>
                    )}
                    <div class="info">
                      <h3>
                        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                      </h3>
                      <p class="dek">{post.data.description}</p>
                      <div class="foot">
                        <span class="meta-date">
                          <FormattedDate date={post.data.pubDate} />
                        </span>
                        {post.data.tags &&
                          post.data.tags.map((tag: string) => (
                            <span class="pill pill-accent">{tag}</span>
                          ))}
                      </div>
                    </div>
                  </article>
                ))}
              </>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
