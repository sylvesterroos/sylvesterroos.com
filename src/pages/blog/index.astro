---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout>
    <section>
        <ul class="flex flex-wrap gap-8 list-none m-0 p-0">
            {
                posts.map((post) => (
                    <li class="w-[calc(50%-1rem)] first:w-full first:mb-4 first:text-center first:place-items-center">
                        <a
                            href={`/blog/${post.id}/`}
                            class="block transition-all duration-200"
                        >
                            <img
                                width={720}
                                height={360}
                                src={post.data.heroImage}
                                alt=""
                                class="mb-2 rounded-xl hover:shadow-lg"
                            />
                            <h4 class="text-2xl font-bold m-0 text-black leading-none first:text-[2.369rem] hover:text-accent">
                                {post.data.title}
                            </h4>
                            <p class="m-0 text-gray-500 hover:text-accent">
                                <FormattedDate date={post.data.pubDate} />
                            </p>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>
</BaseLayout>

